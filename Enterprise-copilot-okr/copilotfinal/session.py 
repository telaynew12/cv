#!/usr/bin/env python3
"""
Fetch Objective Data from Backend API
Fetches all objectives from GET /api/v1/objective endpoint
Decrypts the response and saves to file
"""

import os
import requests
import json
from dotenv import load_dotenv
import urllib3
from datetime import datetime
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.backends import default_backend

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
load_dotenv()

BASE_URL = os.getenv("BASE_URL", "https://ie-okr-backend.selamnew.com/api/v1")
FIREBASE_ID_TOKEN = os.getenv("FIREBASE_API_KEY")
TENANT_ID = os.getenv("TENANT_ID", "9b320d7d-bece-4dd4-bb87-dd226f70daef")

ENCRYPTION_KEY = os.getenv("ENCRYPTION_KEY")
ENCRYPTION_SALT = os.getenv("ENCRYPTION_SALT", "default-salt")
ENCRYPTION_IV = os.getenv("ENCRYPTION_IV")


def derive_key(password: str, salt_hex: str) -> bytes:
    salt_bytes = bytes.fromhex(salt_hex)
    salt_string = salt_bytes.decode('utf-8', errors='replace')
    kdf = PBKDF2HMAC(algorithm=hashes.SHA256(), length=32, salt=salt_string.encode('utf-8'),
                     iterations=1000, backend=default_backend())
    return kdf.derive(password.encode('utf-8'))


def decrypt_response(encrypted_text: str) -> dict:
    if not ENCRYPTION_KEY or not ENCRYPTION_IV:
        raise Exception("Encryption keys not found in .env")
    parts = encrypted_text.split(':')
    if len(parts) != 2:
        raise ValueError(f"Invalid encrypted format")
    iv_hex, encrypted_data_with_tag = parts
    key = derive_key(ENCRYPTION_KEY, ENCRYPTION_SALT)
    aesgcm = AESGCM(key)
    decrypted = aesgcm.decrypt(bytes.fromhex(iv_hex), bytes.fromhex(encrypted_data_with_tag), None)
    return json.loads(decrypted.decode('utf-8'))


def fetch_objectives(save_to_file=True):
    """Fetch all objectives from /api/v1/objective endpoint"""
    if not FIREBASE_ID_TOKEN:
        print("❌ No Firebase token found")
        return None
    
    headers = {
        "Authorization": f"Bearer {FIREBASE_ID_TOKEN}",
        "tenantId": TENANT_ID,
        "Content-Type": "application/json"
    }
    
    # Use the endpoint that gets all objectives
    url = f"{BASE_URL}/objective/objective-filter/all/objective"
    print(f"{'='*80}\n📥 FETCHING ALL OBJECTIVES\n{'='*80}")
    print(f"Endpoint: {url}\nTenant ID: {TENANT_ID}\n")
    
    try:
        print("   ⏳ Connecting to server...")
        response = requests.get(url, headers=headers, timeout=30, verify=False)
        print(f"📊 Status Code: {response.status_code}\n")
        
        if response.status_code not in [200, 201]:
            print(f"❌ Error: Status {response.status_code}")
            print(f"Response: {response.text[:200]}")
            return None
        
        response_data = response.json()
        
        if isinstance(response_data, dict) and 'data' in response_data and isinstance(response_data['data'], str):
            print("   🔓 Decrypting...")
            data = decrypt_response(response_data['data'])
            print("   ✅ Decrypted\n")
        else:
            data = response_data
            print("   ✅ Response is not encrypted\n")
        
        # Extract objectives data - handle nested structure
        objectives = data if isinstance(data, list) else [data] if data else []
        
        # Extract unique sessionIds only
        # Handle structure: [{items: [{sessionId: ...}, ...]}, ...]
        session_ids = set()
        for item in objectives:
            if isinstance(item, dict):
                # Check if it has 'items' array
                if 'items' in item and isinstance(item['items'], list):
                    for obj in item['items']:
                        if isinstance(obj, dict) and obj.get('sessionId'):
                            session_ids.add(obj['sessionId'])
                # Or if sessionId is directly on the item
                elif item.get('sessionId'):
                    session_ids.add(item['sessionId'])
        
        session_ids_list = sorted(list(session_ids))
        
        result = {
            "success": True,
            "timestamp": datetime.now().isoformat(),
            "endpoint": url,
            "status_code": response.status_code,
            "total_objectives": len(objectives),
            "unique_session_ids": session_ids_list,
            "session_ids_count": len(session_ids_list)
        }
        
        print(f"✅ Total objectives fetched: {len(objectives)}")
        print(f"📋 Unique session IDs found: {len(session_ids_list)}\n")
        
        if save_to_file:
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            filename = f"session_ids_{timestamp}.json"
            filepath = os.path.join(os.path.dirname(os.path.abspath(__file__)), filename)
            with open(filepath, 'w', encoding='utf-8') as f:
                json.dump({
                    "session_ids": session_ids_list,
                    "count": len(session_ids_list),
                    "timestamp": datetime.now().isoformat()
                }, f, indent=2, ensure_ascii=False)
            print(f"💾 Session IDs saved to: {filepath}\n")
        
        if session_ids_list:
            print(f"📋 Session IDs (first 10):\n")
            for idx, session_id in enumerate(session_ids_list[:10], 1):
                print(f"{idx}. {session_id}")
            if len(session_ids_list) > 10:
                print(f"... and {len(session_ids_list) - 10} more\n")
            else:
                print()
        
        return result
    except Exception as e:
        print(f"❌ Error: {e}")
        import traceback
        traceback.print_exc()
        return None


def main():
    result = fetch_objectives(save_to_file=True)
    
    if result:
        print(f"\n✅ Successfully fetched session IDs!")
        print(f"📊 Total objectives: {result['total_objectives']}")
        print(f"📋 Unique session IDs: {result['session_ids_count']}")
    else:
        print(f"\n❌ Failed to fetch session IDs")


if __name__ == "__main__":
    main()

